# Use the same MongoDB connection string as the client.
MONGO_URI=mongodb://127.0.0.1:27017

# Express listens on this port. Defaults to 5000.
PORT=5000

# TMDB Read Access Token; required for TMDB search and metadata lookup.
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
# Optional: used to retrieve IMDb ratings.
OMDB_API_KEY=

CLIENT_URL=eg:http://localhost:3000